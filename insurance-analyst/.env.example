# Copy to .env.local. Never commit real secrets.
# Optional: without a key, the prototype uses a grounded keyword retrieval fallback.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# WhatsApp click-to-chat destination in international format, digits only.
# Keep empty until the business number and approved workflow are ready.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Keep false until privacy notice, consent wording, security and regulatory review are complete.
ENABLE_LEAD_HANDOFF=false